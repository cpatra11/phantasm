# Copy to .env.local and fill in. Every value is optional for local use:
# without the keys below, the agent runs on deterministic mocks and the store is in memory.

# --- Meta Model API (OpenAI-compatible) ---
META_API_BASE_URL=
META_API_KEY=

# --- Brand extraction ---
FIRECRAWL_API_KEY=

# --- Database (Neon Postgres). Unset = in-memory store, data lost on restart ---
DATABASE_URL=

# --- Asset storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Remotion Lambda (set by `npm run deploy:remotion`) ---
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_AWS_REGION=us-east-1

# --- Accounts ---
# Free generation runs per account. Each agent run costs one.
CREDITS_PER_USER=5
# Public URL of the app (used by the browser auth client when it is not the same origin).
NEXT_PUBLIC_APP_URL=
